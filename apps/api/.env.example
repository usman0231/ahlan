# ---------------------------------------------------------------------------
# Ahlan HSE API - local development
# Copy to .env; never commit a filled-in copy.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list, or * in development.
CORS_ORIGINS=*
LOG_LEVEL=debug

# Postgres (docker compose service "postgres")
DATABASE_URL=postgresql://ahlan:ahlan@localhost:5432/ahlan_hse?schema=public

# Redis / BullMQ (docker compose service "redis")
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to 0 on the HTTP process when you run `start:worker` separately.
QUEUE_CONCURRENCY=2

# JWT - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# S3-compatible storage (docker compose service "minio")
S3_ENDPOINT=http://localhost:9000
# Address phones use for presigned photo URLs (defaults to S3_ENDPOINT).
# Android emulator: http://10.0.2.2:9000 ; physical phone: http://<LAN-IP>:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ahlan
S3_SECRET_ACCESS_KEY=ahlan-secret
S3_BUCKET_EVIDENCE=ahlan-evidence
S3_BUCKET_REPORTS=ahlan-reports
# MinIO needs path-style addressing; R2/S3 do not.
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# Mail (docker compose service "mailpit", UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ahlan HSE <no-reply@ahlan.local>"

# PDF rendering. Run `pnpm --filter api browsers:install` once.
PDF_CHROMIUM_PATH=
PDF_TIMEOUT_MS=60000

# AI Intelligence. Leave the key empty in development: the API falls back to a
# deterministic local provider so nothing leaves the machine.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_PROMPT_VERSION=2026-10-01

# Where links in emails open (e.g. the password reset page): the app, not the
# API. Web preview: http://localhost:8081 ; native builds can use ahlanhse://
PUBLIC_APP_URL=http://localhost:8081
