# ---------------------------------------------------------------------------
# Ahlan HSE mobile - local development
# Copy to .env. Only EXPO_PUBLIC_* variables reach the app bundle, so nothing
# secret belongs in this file: the API holds every key.
# ---------------------------------------------------------------------------

# Android emulator reaches the host machine at 10.0.2.2.
# iOS simulator: http://localhost:3000
# A physical phone: your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

EXPO_PUBLIC_API_PREFIX=/api/v1

# Seconds between automatic sync attempts while the app is foregrounded.
EXPO_PUBLIC_SYNC_INTERVAL_SECONDS=120

# `1` prints sync and request logs to Metro.
EXPO_PUBLIC_DEBUG=1
